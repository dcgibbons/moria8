  "capabilities": {
    "reu_overlay_cache": false,
    "aux_overlay_cache": true,
    "vdc_80_column": false,
    "ted_display": false,
    "native_80_column": true,
    "sid_sound": false,
    "ted_sound": false,
    "speaker_sound": true,
    "two_drive_save": false
