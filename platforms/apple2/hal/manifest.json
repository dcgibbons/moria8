{
  "platform": "apple2",
  "machine": {
    "cpu": "6502",
    "ram_kb": 128
  },
  "display": {
    "hardware": "apple2e_80col_text",
    "columns": 80,
    "rows": 24,
    "viewport": {
      "x": 1,
      "y": 2,
      "width": 78,
      "height": 18
    },
    "screen_ram": "$0400 main + $0400 aux (interleaved)",
